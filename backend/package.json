{
  "name": "gouanzouh-backend",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "typeorm": "typeorm-ts-node-esm",
    "migration:generate": "npm run build && typeorm migration:generate",
    "migration:create": "typeorm migration:create",
    "migration:run": "npm run build && typeorm migration:run",
    "migration:revert": "npm run build && typeorm migration:revert",
    "migration:show": "typeorm migration:show"
  },
  "dependencies": {
    "bcrypt": "^5.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.0",
    "reflect-metadata": "^0.1.13",
    "sqlite3": "^6.0.1",
    "typeorm": "^0.3.18",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.4.2",
    "@types/uuid": "^9.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
}
